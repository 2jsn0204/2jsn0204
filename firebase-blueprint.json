{
  "entities": {
    "Prompt": {
      "title": "Prompt",
      "description": "AI prompt item stored in the user's prompt warehouse.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Display title of the prompt",
          "minLength": 1,
          "maxLength": 200
        },
        "category": {
          "type": "string",
          "description": "Prompt category name",
          "enum": ["사진 합성", "스타일 변환", "캐릭터·포스터"],
          "minLength": 1,
          "maxLength": 50
        },
        "content": {
          "type": "string",
          "description": "Full prompt text content preserving line breaks and formatting (supports >1000 characters)",
          "minLength": 1,
          "maxLength": 20000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the prompt was created"
        }
      },
      "required": ["title", "category", "content", "createdAt"]
    }
  },
  "firestore": {
    "/prompts/{promptId}": {
      "schema": {
        "$ref": "#/entities/Prompt"
      },
      "description": "Collection of AI prompts ordered by createdAt ascending."
    }
  }
}
